*.pyc

# ============================================================
# rccar — repo-wide .gitignore
# Covers the Python rover stack, the Unity projects, and the
# ML-Agents training folder now that all three live here.
# ============================================================

# ---------- Python (rover stack) ----------
*.pyc
__pycache__/
env/
venv/
.venv/

# ---------- Unity (applies to every project under unity_sim_training/) ----------
# All of these are regenerated by the editor on first open. Committing them
# causes constant spurious diffs and can actively corrupt a clone, because
# Library/ holds machine-specific import caches.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Solution and project files: Unity regenerates these from Assets/.
# Ignoring them is also what makes the project rename painless -- delete them
# and the editor recreates them under the new name.
*.csproj
*.sln
*.slnx
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# Crash dumps and editor droppings
sysinfo.txt
*.stackdump
mono_crash.*
crashlytics-build.properties

# Asset meta files must be committed, but meta files for IGNORED folders
# must not -- this is the classic Unity gitignore trap.
/[Ll]ibrary.meta
/[Tt]emp.meta
/[Bb]uild.meta
/[Ll]ogs.meta

# ---------- ML-Agents training output ----------
# TensorBoard event files and .pt checkpoints are large, numerous, and
# regenerable by re-running training. Only the exported .onnx is a deliverable.
# See the 2026-08-05 logbook entry: the obstacles_v3 history deliberately stays
# in the archived car-simulation-5 repo rather than being imported here.
unity_sim_training/training/results/**/events.out.tfevents.*
unity_sim_training/training/results/**/*.pt

# Keep the exports and the run metadata that make a run reproducible.
!unity_sim_training/training/results/**/*.onnx
!unity_sim_training/training/results/**/configuration.yaml
!unity_sim_training/training/results/**/run_logs/

# ---------- Archives / scratch ----------
*.zip
*.tar.gz